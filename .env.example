# Copy to .env and fill in. Never commit .env.

# Same secret as in the GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=
# Fine-grained personal access token with Contents (Read) and Pull requests (Read and write).
GH_TOKEN=

# Claude auth, set exactly one (ANTHROPIC_API_KEY wins if both are set).
# Plan usage, token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# API billing
ANTHROPIC_API_KEY=

# Optional comma-separated owner/repo allowlist. Empty means every repo the token can access.
ALLOWED_REPOS=

# Optional review settings, defaults shown.
# REVIEW_LANGUAGE=German
# REVIEW_PROMPT_FILE=/app/review_prompt.md
# For the ponytail review: REVIEW_PROMPT_FILE=/app/prompt/ponytail_review.md
# CLAUDE_MODEL=
# CLAUDE_MAX_TURNS=40
# CLAUDE_ALLOWED_TOOLS=Read,Grep,Glob
# CLAUDE_DISALLOWED_TOOLS=Bash,Edit,Write,WebFetch,WebSearch
# CLAUDE_EXTRA_ARGS=

# Optional limits, defaults shown.
# MAX_CONCURRENT_REVIEWS=2
# MAX_DIFF_CHARS=150000
# REVIEW_TIMEOUT=1800
